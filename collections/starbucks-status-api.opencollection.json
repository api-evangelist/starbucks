{
  "opencollection": "1.0.0",
  "info": {
    "name": "Starbucks Loyalty Status API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get API Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.starbucks.com/status"
          },
          "docs": "Returns the current health and operational status of the Starbucks API."
        }
      ]
    }
  ],
  "bundled": true
}